# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Hugging Face — required to access Revolab datasets and gated models
HF_TOKEN=

# Deepgram — required for nova-3 model
DEEPGRAM_API_KEY=

# AssemblyAI — required for universal-2 model
ASSEMBLYAI_API_KEY=

# Google Gemini — required for gemini model
GEMINI_API_KEY=

# ElevenLabs — required for elevenlabs model
ELEVENLABS_API_KEY=

# Ilmu AI — required for ilmu-asr-v4.2 model
ILMU_API_KEY=

# Revolab STT API — required for aisyah-1.0-flash / aisyah-1.0-pro
REVOLAB_API_KEY=

# DashScope (Alibaba) — required for qwen-audio-3.0-asr-flash model
DASHSCOPE_API_KEY=

# Optional: pin to a specific GPU (e.g. if running on a shared machine)
CUDA_VISIBLE_DEVICES=
